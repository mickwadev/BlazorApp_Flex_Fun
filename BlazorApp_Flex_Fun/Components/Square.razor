@rendermode InteractiveServer
@using System.Text

<div onclick="@HandleClick"  style="@StyleBuilder()">
    <p style="flex-grow:0;color:bisque;" >
        @Data.Id
    </p>
    </div>
@code {
    [Parameter, EditorRequired]
    public SquareData Data { get; set; }

    [Parameter]
    public EventCallback<SquareData> DataChanged { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    private string SetDisplay()
    {
        // flex is for controlling children, and here I always want to control children with flex

        return Data.Style.DisplayType switch
        {
            DisplayType.Block => "flex",
            DisplayType.Inline => "inline flex"
        };
    }

    private string StyleBuilder()
    {
        StringBuilder sb = new StringBuilder();
        sb.Append($"display:{SetDisplay()};align-items:center;justify-content:center;");
        sb.Append($"border:2px {(IsSelected?"dotted":"solid")} {Data.Style.BorderColor};");
        if (Data.Style.Width != null)
        {
            sb.Append($"width:{Data.Style.Width}px;");
        }
        if (Data.Style.Height != null)
        {
            sb.Append($"height:{Data.Style.Height}px;");
        }

         
        sb.Append($"margin-top:{Data.Style.MarginTop}px;");
        sb.Append($"margin-bottom:{Data.Style.MarginBottom}px;");
        sb.Append($"margin-left:{Data.Style.MarginLeft}px;");
        sb.Append($"margin-right:{Data.Style.MarginRight}px;");
        
        

        return sb.ToString();
    }

    private async Task HandleClick()
    {
        await DataChanged.InvokeAsync(Data);    
    }
}
