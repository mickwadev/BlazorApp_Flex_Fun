@rendermode InteractiveServer
@using System.Text

    <div onclick="@HandleClick" style="@StyleBuilder();color:bisque;">
         @Data.Id
    </div>
@code {
    [Parameter, EditorRequired]
    public SquareData Data { get; set; }

    [Parameter]
    public EventCallback<SquareData> DataChanged { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    private string SetDisplay()
    {
        return Data.Style.DisplayType switch
        {
            DisplayType.Block => "block",
            DisplayType.Inline => "inline",
            DisplayType.InlineBlock => "inline-block"
        };
    }

    private string StyleBuilder()
    {
        StringBuilder sb = new StringBuilder();
        sb.Append($"display:{SetDisplay()};");
        sb.Append($"border:2px {(IsSelected?"dotted":"solid")} {Data.Style.BorderColor};");
        
        if (Data.Style.UseFixedWidth)
        {
            sb.Append($"width:{Data.Style.Width}px;");
        }
        if (Data.Style.UseFixedHeight)
        {
            sb.Append($"height:{Data.Style.Height}px;");
        }
 
        if (Data.Style.MarginTop >0)  sb.Append($"margin-top:{Data.Style.MarginTop}px;");
        if (Data.Style.MarginBottom > 0) sb.Append($"margin-bottom:{Data.Style.MarginBottom}px;");
        if (Data.Style.MarginLeft > 0) sb.Append($"margin-left:{Data.Style.MarginLeft}px;");
        if (Data.Style.MarginRight > 0) sb.Append($"margin-right:{Data.Style.MarginRight}px;");

        if (Data.Style.PaddingTop > 0) sb.Append($"padding-top:{Data.Style.PaddingTop}px;");
        if (Data.Style.PaddingBottom > 0) sb.Append($"padding-bottom:{Data.Style.PaddingBottom}px;");
        if (Data.Style.PaddingLeft > 0) sb.Append($"padding-left:{Data.Style.PaddingLeft}px;");
        if (Data.Style.PaddingRight > 0) sb.Append($"padding-right:{Data.Style.PaddingRight}px;");
        
        

        return sb.ToString();
    }

    private async Task HandleClick()
    {
        await DataChanged.InvokeAsync(Data);    
    }
}
