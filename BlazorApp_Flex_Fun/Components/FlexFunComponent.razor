@rendermode InteractiveServer
<PageTitle>Learn Flex 🤩</PageTitle>
<p>Container settings:</p>
@*Fot those inputs I do not need to inform that value has changed, because they are not inside other component*@
<input type="range" min="100" max="1000" step="1" @bind="@containerWidth" @bind:event="oninput"  />
<input type="range" min="100" max="1000" step="1" @bind="@containerHeight" @bind:event="oninput"  />
<input type="range" min="0" max="100" step="1" @bind="@rowGap" @bind:event="oninput" />
<input type="range" min="0" max="100" step="1" @bind="@gap" @bind:event="oninput" />
<p>@containerWidth x @containerHeight @rowGap @gap </p>
<div style="display:flex;gap:5px;">
    <FlexPropertyComponent @bind-Wlasciwosc="flexDirection" ShowHint="ShowHint"/>
    <FlexPropertyComponent @bind-Wlasciwosc="flexWrap" ShowHint="ShowHint"/>
    <FlexPropertyComponent @bind-Wlasciwosc="justifyContent" ShowHint="ShowHint"/>
    <FlexPropertyComponent @bind-Wlasciwosc="alignContent" ShowHint="ShowHint"/>
    <FlexPropertyComponent @bind-Wlasciwosc="alignItems" ShowHint="ShowHint" />
    <HintsViewer Hint="@hint" />
</div>

 <button @onclick="ResetowankoWartosci">Resetuj wartości </button>

<div class="rameczka" style="@GenerateStyle()">
    @foreach(OpcjeRamki or in initialFrames)
    {
        <Ramka 
            opcje="or" 
            @*To jest bardzo ciekawe! Teraz wartość selected zmieni się przy każdym renderowaniu!*@
            Selected = "@(or == aktualnieWybranaRamka)"
            Wybrana="WybranaRamka"
            RamkaOnPointerEnter="RamknaOnPointerEnter"
            RamkaOnPointerLeave="RamknaOnPointerLeave"/>
    }
 </div>

<RamkoZmieniacz @bind-Opcje="aktualnieWybranaRamka" />
@if (RamkaAktualnyOver is not null)
{
    var r = initialFrames.Find(or => or.Id == RamkaAktualnyOver);
    <p>@FlexHelpers.StyleFromValues(r.Style)</p>
}

@if(aktualnieWybranaRamka is not null)
{
    <p>flex-basis: @aktualnieWybranaRamka.Style.FlexBasis</p>
}
@code {
    public int containerWidth { get; set; } = 500;
    public int containerHeight { get; set; } = 222;
    public int rowGap { get; set; } = 0;    // gap between rows
    public int gap { get; set; } = 0;       // gap between elements
    OpcjeRamki? aktualnieWybranaRamka;
    int? RamkaAktualnyOver = null;
    string? hint = "";

    List<OpcjeRamki> initialFrames = CreateInitialFrames();

    FlexDirection flexDirection = FlexDirection.Row;
    FlexWrap flexWrap = FlexWrap.Wrap;
    JustifyContent justifyContent = JustifyContent.FlexStart;
    AlignContent alignContent = AlignContent.FlexStart;
    AlignItems alignItems = AlignItems.FlexStart;

    string GenerateStyle()
    {
        var st = $"width: {containerWidth}px; height: {containerHeight}px;";
        return st + FlexHelpers
        .GetStyle(flexDirection, justifyContent, alignContent, alignItems, flexWrap, gap, rowGap);
    }

    void ResetowankoWartosci()
    {
        flexDirection = FlexDirection.Row;
        flexWrap = FlexWrap.Wrap;
        justifyContent = JustifyContent.FlexStart;
        alignContent = AlignContent.FlexStart;
    }

    private void WybranaRamka(OpcjeRamki wybrana)
    {
        aktualnieWybranaRamka = wybrana;
    }

    private void RamknaOnPointerEnter(int id)
    {
        RamkaAktualnyOver = id;
    }

    private void RamknaOnPointerLeave()
    {
        //   RamkaAktualnyOver = null;
    }

    private static List<OpcjeRamki> CreateInitialFrames()
    {
        StyleValues InitValues() => new StyleValues() { };

        List<OpcjeRamki> ramki = new()
        {
            new OpcjeRamki(){Owocek = "🍓", Style = InitValues(), Id=0 },
            new OpcjeRamki(){Owocek = "🥥", Style = InitValues(), Id=1 },
            new OpcjeRamki(){Owocek = "🍒", Style = InitValues(), Id=2 },
            new OpcjeRamki(){Owocek = "🍋", Style = InitValues(), Id=3 },
            new OpcjeRamki(){Owocek = "🍌", Style = InitValues(), Id=4 },
            new OpcjeRamki(){Owocek = "🥝", Style = InitValues(), Id=5 }
        };
        return ramki;
    }

    private void ShowHint(string hint)
    {
        this.hint = FlexHelpers.EnumToCss(hint);
    }
}
