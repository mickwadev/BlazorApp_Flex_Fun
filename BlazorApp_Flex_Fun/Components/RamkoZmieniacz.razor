@rendermode InteractiveServer
@if (Opcje is not null)
{
    <p> @Opcje.Owocek</p>
    <button @onclick="() => { 
        Opcje.Style.Height += 10;
        OpcjeChanged.InvokeAsync(Opcje);
    }">➕</button>
    <button @onclick="() => {
        Opcje.Style.Height -= 10;
        OpcjeChanged.InvokeAsync(Opcje);
    }">➖</button>

    // Here I must invoke callback to inform parent about change:
    <input type="range" min="0" max="300" step="1" @bind="@(Opcje.Style.FlexBasis)" @bind:event="oninput" @bind:after="()=>{OpcjeChanged.InvokeAsync(Opcje);}" />
    
}


@code {
    [Parameter]
    public OpcjeRamki? Opcje { get; set;}

    [Parameter]
    public EventCallback<OpcjeRamki?> OpcjeChanged { get; set; }
}
