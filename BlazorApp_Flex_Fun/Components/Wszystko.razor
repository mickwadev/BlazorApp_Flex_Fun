@rendermode InteractiveServer
   

<FlexPropertyComponent
    NazwaParametru="flex-direction"
    T="Direction" 
    KonwerterEnuma="FlexHelpers.Enum2String"
    Wlasciwosc="selectedDirection"
    ZmianaWartosci="UpdateDirection" />


 <button @onclick="ResetowankoWartosci">Resetuj wartości </button>

<div class="rameczka" style="@GenerateStyle()">
<Ramka Znaczek="🍐" />
<Ramka Znaczek="🍓" />
<Ramka Znaczek="🥥" />
    <Ramka Znaczek="🍌" />
</div>

@code {
    Direction selectedDirection = Direction.Row;

    string GenerateStyle()
    {
        return FlexHelpers.GetStyle(selectedDirection);
    }

    private void UpdateDirection(Direction dir)
    {
        selectedDirection = dir;
        StateHasChanged();
    }

    void ResetowankoWartosci()
    {
        selectedDirection = Direction.Row;
    }
}
