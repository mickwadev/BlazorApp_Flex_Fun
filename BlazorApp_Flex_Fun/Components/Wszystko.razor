@rendermode InteractiveServer
   

<FlexPropertyComponent
    NazwaParametru="flex-direction"
    T="FlexDirection" 
    Wlasciwosc="selectedDirection"
    WlasciwoscChanged="UpdateFlexDirection" />

<FlexPropertyComponent NazwaParametru="justify-content"
                       T="JustifyContent"
                       Wlasciwosc="justifyContent"
                       @* WłasciwoscChanged to nazwa na podstawie Wlasciwosc 
                           Własny callback do zmiany jest zbędny i to ma być EventCallback
                       *@
                       WlasciwoscChanged="UpdateJustifyContent" />

 <button @onclick="ResetowankoWartosci">Resetuj wartości </button>

<div class="rameczka" style="@GenerateStyle()">
    <Ramka Znaczek="🍐" />
    <Ramka Znaczek="🍓" />
    <Ramka Znaczek="🥥" />
    <Ramka Znaczek="🍌" />
</div>
@code {
    FlexDirection selectedDirection = FlexDirection.Row;
    JustifyContent justifyContent = JustifyContent.FlexStart;

    string GenerateStyle()
    {
        return FlexHelpers.GetStyle(selectedDirection, justifyContent);
    }

    private void UpdateFlexDirection(FlexDirection dir)
    {
        selectedDirection = dir;
    }

    private void UpdateJustifyContent(JustifyContent jc)
    {
        justifyContent = jc;
    }

    void ResetowankoWartosci()
    {
        selectedDirection = FlexDirection.Row;
        justifyContent = JustifyContent.FlexStart;
    }
}
