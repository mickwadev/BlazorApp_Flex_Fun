@rendermode InteractiveServer
 

<div style="display:flex">
    <FlexPropertyComponent @bind-Wlasciwosc="selectedDirection"/>
    <FlexPropertyComponent @bind-Wlasciwosc="justifyContent" />
    <FlexPropertyComponent @bind-Wlasciwosc="alignContent" />
    <FlexPropertyComponent @bind-Wlasciwosc="alignItems" />
</div>
 <button @onclick="ResetowankoWartosci">Resetuj wartości </button>

<div class="rameczka" style="@GenerateStyle()">
    <Ramka Znaczek="🍓" Rozmiar="100"  />
    <Ramka Znaczek="🥥" Rozmiar="200" />
    <Ramka Znaczek="🍌" Rozmiar="50" />
</div>
@code {
    FlexDirection selectedDirection = FlexDirection.Row;
    JustifyContent justifyContent = JustifyContent.FlexStart;
    AlignContent alignContent = AlignContent.FlexStart;
    AlignItems alignItems = AlignItems.FlexStart;

    string GenerateStyle()
    {
        return FlexHelpers
        .GetStyle(selectedDirection, justifyContent, alignContent, alignItems);
    }

    private void UpdateFlexDirection(FlexDirection dir)
    {
        selectedDirection = dir;
    }

    private void UpdateJustifyContent(JustifyContent jc)
    {
        justifyContent = jc;
    }
    private void UpdateAlignContent(AlignContent ac)
    {
        alignContent = ac;
    }

    private void UpdateAlignItems(AlignItems ai)
    {
        alignItems = ai;
    }

    void ResetowankoWartosci()
    {
        selectedDirection = FlexDirection.Row;
        justifyContent = JustifyContent.FlexStart;
        alignContent = AlignContent.FlexStart;
    }
}
