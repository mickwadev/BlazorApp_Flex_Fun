<div id="@opcje.Id" class="moja-ramka" style="@dodatkowyStyl width:@(opcje.Style.Width)px; height:@(opcje.Style.Height)px;" 
@onclick="()=>
{
    clicked = !clicked;
    Wybrana.InvokeAsync(opcje);
}"
@onpointerenter="OnPointerEnter"
@onpointerleave="OnPointerLeave"
>
    <p>@opcje.Owocek</p>
</div>

@code {
    [Parameter, EditorRequired]
    public OpcjeRamki opcje { get; set; }

    [Parameter]
    public EventCallback<OpcjeRamki> Wybrana { get; set; }
    bool clicked = false;
    string dodatkowyStyl => clicked ? "border:dotted yellow 2px;":"";

    [Parameter]
    public EventCallback<string> RamkaOnPointerEnter{ get; set; }

    [Parameter]
    public EventCallback RamkaOnPointerLeave { get; set; }

    private async Task OnPointerEnter(PointerEventArgs e)
    {
        await RamkaOnPointerEnter.InvokeAsync($"{opcje.Owocek} [{opcje.Id}]");
    }

    private async Task OnPointerLeave(PointerEventArgs e)
    {
        await RamkaOnPointerLeave.InvokeAsync();
    }
}
