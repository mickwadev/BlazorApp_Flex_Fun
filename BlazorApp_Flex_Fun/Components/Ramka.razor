<div class="moja-ramka" style="@dodatkowyStyl width:@(opcje.Width)px; height:@(opcje.Height)px;" 
@onclick="()=>
{
    clicked = !clicked;
    Wybrana.InvokeAsync(opcje);
}">
    <p>@opcje.Owocek</p>
</div>

@code {
    [Parameter, EditorRequired]
    public OpcjeRamki opcje { get; set; }

    [Parameter]
    public EventCallback<OpcjeRamki> Wybrana { get; set; }
    bool clicked = false;
    string dodatkowyStyl => clicked ? "border:dotted yellow 2px;":"";
}
