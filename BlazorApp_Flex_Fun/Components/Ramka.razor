<div class="moja-ramka" style="@dodatkowyStyl width:@(Rozmiar)px; height:@(Rozmiar)px;" 
@onclick="()=>
{
    clicked = !clicked;
}">
    <p>@Znaczek</p>
</div>

@code {
    [Parameter]
    public string Znaczek { get; set; }

    [Parameter]
    public int Rozmiar { get; set; }

    bool clicked = false;
    string dodatkowyStyl => clicked ? "border:dotted yellow 2px;":"";
}
