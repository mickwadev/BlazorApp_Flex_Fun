@rendermode InteractiveServer
@using FH = FlexHelpers

<PageTitle>Learn dislpay types 🤩</PageTitle>
<p>@info</p>
<div style="width:333px;height:333px;border:solid 2px #0079c8">

    @for(int i=0;i<dd.Count;i++)
    {
        var index = i; // ten index jest potrzebny, żeby była nowa wartość dla każdego wykonania w pętli, bo tam blazor kompiluje z ref czy coś :P
        Paczaj(index);
        info += dd[index].Id;
        <Square @key="dd[index].Id" 
        @bind-Data="dd[index]"
        @bind-Data:after="async () => await ChangeSelecteSquare(dd[index])"
        IsSelected="@(dd[index] == SelectedData)" />
    }
  

    
</div>
<div style="display:flex;flex-direction:column;align-items:flex-start">
   @*  <InputRadioGroup @bind-Value="displayType">
    @foreach (DisplayType dt in Enum.GetValues<DisplayType>())
    {
