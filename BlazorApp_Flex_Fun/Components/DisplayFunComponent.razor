            @FH.EnumToCss(dt.ToString())
        </label>
    }
    </InputRadioGroup> *@

    <p>Block - stars in new line, and stretches to whole width</p>
</div>
@code {
    List<SquareData> dd;  
    string info = "Info:";

    protected override void OnInitialized()
    {
        dd = InitSquares();
        base.OnInitialized();
    }

    List<SquareData> InitSquares()
    {
        List<SquareData> sd = new();
        var colors = GetColors();
        for(int i=0;i< colors.Count;i++)
        {
            sd.Add(new SquareData(colors[i]) { Id = i });
        }
        return sd;
    }

    SquareData? SelectedData = null;

    List<string> GetColors()
    {
        List<string> colors = new List<string>()
        {
            "#e87b05",
            "#2cb903",
            "#9d00cb",
            "#f7fa00"
        };
        return colors;
    }

    private async Task ChangeSelecteSquare(SquareData sd)
    {
        SelectedData = sd;
    }

    private void Paczaj<T>(T msg) => Console.WriteLine($"👀👀👀👀👀 {msg.ToString()}");

}
