@rendermode InteractiveServer
@typeparam T where T:struct, Enum
@using FH = FlexHelpers

<div style="display:flex; flex-shrink:0; flex-direction:column; border: solid 2px #999; border-radius:8px;"
@onmouseenter="OnMouseEnter">
    <p style="align-self:center" class="nazwa-parametru">@ParamTypeName</p>
    @*Name musi być unique bo inaczej będzie traktował wszystkie InputRadio jak jedną grupę *@ 
    <InputRadioGroup Name="@ParamTypeName" @bind-Value="Wlasciwosc" @bind-Value:after="ZmienionaWartosc">

@foreach (var v in Enum.GetValues<T>())
{
    <label style="color:antiquewhite">
        <InputRadio Value="v" /> ✨@(FH.EnumToCss(v.ToString()))
    </label>
}
</InputRadioGroup>
</div>

@code
    {
    private string ParamTypeName => FH.EnumToCss(typeof(T).Name);

    [Parameter]
    public T Wlasciwosc { get; set; }
    // Ten callback musi się nazywać zgodnie ze schematem nazwy
    [Parameter]
    public EventCallback<T> WlasciwoscChanged { get; set; }

    [Parameter]
    public EventCallback<string> ShowHint { get; set; }

    private Task ZmienionaWartosc() => WlasciwoscChanged.InvokeAsync(Wlasciwosc);

    private void OnMouseEnter()
    {
        ShowHint.InvokeAsync(typeof(T).Name);
    }
}