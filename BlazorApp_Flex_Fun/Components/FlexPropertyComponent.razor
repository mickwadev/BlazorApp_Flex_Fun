@rendermode InteractiveServer
@typeparam T where T:struct, Enum

<div style="display:flex; flex-direction:column; border: solid 2px #999; border-radius:8px;">
    <p class="nazwa-parametru">@NazwaParametru</p>
    @*Name musi być unique bo inaczej będzie traktował wszystkie InputRadio jak jedną grupę *@ 
<InputRadioGroup Name="@NazwaParametru"  @bind-Value="Wlasciwosc" @bind-Value:after="ZmienionaWartosc">

@foreach (var v in Enum.GetValues<T>())
{
    <label style="color:antiquewhite">
                <InputRadio Value="v" /> ✨@(FlexHelpers.EnumToCss(v.ToString()))
    </label>
}
</InputRadioGroup>
</div>

@code
    {
    [Parameter]
    public string NazwaParametru { get; set; }

    [Parameter]
    public T Wlasciwosc { get; set; }

    [Parameter]
    public EventCallback<T> WlasciwoscChanged { get; set; }

    private Task ZmienionaWartosc() => WlasciwoscChanged.InvokeAsync(Wlasciwosc);
}